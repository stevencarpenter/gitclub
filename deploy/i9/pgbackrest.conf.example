; pgBackRest configuration for the GitClub disaster recovery standby.
;
; OrbStack: ~/.config/gitclub-dr/pgbackrest.conf, mode 0600. The container
; copies it into /etc/pgbackrest as postgres, mode 0600.
; Linux: /etc/pgbackrest/pgbackrest.conf, owned by postgres, mode 0600.
;
; Copy the repo1-* values from the primary's /etc/pgbackrest/pgbackrest.conf
; after enabling PITR. In particular, repo1-path includes a cluster ID that
; WAL_ARCHIVE_PATH alone omits. Keep credentials out of terminal output.
;
; Railway names the bucket Postgres-PITR and creates the stanza as "main".
; Railway currently issues read/write bucket credentials only. The standby
; uses read operations, but a stolen key can alter or delete the archive.
; Mount this file only into the standby and recovery containers.

[global]
repo1-type=s3
repo1-s3-endpoint=CHANGEME_WAL_ARCHIVE_ENDPOINT
repo1-s3-bucket=CHANGEME_WAL_ARCHIVE_BUCKET
repo1-s3-region=CHANGEME_WAL_ARCHIVE_REGION
repo1-s3-key=CHANGEME_WAL_ARCHIVE_KEY
repo1-s3-key-secret=CHANGEME_WAL_ARCHIVE_SECRET
repo1-s3-uri-style=path
repo1-path=/pgbackrest/CHANGEME_CLUSTER_DIRECTORY_FROM_PRIMARY_CONFIG

; The archive is written by the primary. This machine must never expire or
; write to it, so no retention is configured here on purpose.
process-max=4
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[main]
pg1-path=/var/lib/gitclub/standby
pg1-port=5433
