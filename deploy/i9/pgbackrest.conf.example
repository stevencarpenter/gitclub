; pgBackRest configuration for the GitClub disaster recovery standby.
;
; Install at /etc/pgbackrest/pgbackrest.conf, owned by the postgres user, mode
; 0640. Every value below comes from the Railway Postgres service's variables
; after Point-in-Time Recovery is enabled on it:
;
;   railway variables --service postgres | grep WAL_ARCHIVE
;
; Railway names the bucket Postgres-PITR and creates the stanza as "main".
; Give this machine a READ-ONLY key: the standby only ever reads the archive,
; and a read-only credential cannot damage the primary's recovery history.

[global]
repo1-type=s3
repo1-s3-endpoint=CHANGEME_WAL_ARCHIVE_ENDPOINT
repo1-s3-bucket=CHANGEME_WAL_ARCHIVE_BUCKET
repo1-s3-region=CHANGEME_WAL_ARCHIVE_REGION
repo1-s3-key=CHANGEME_WAL_ARCHIVE_ACCESS_KEY_ID
repo1-s3-key-secret=CHANGEME_WAL_ARCHIVE_SECRET_ACCESS_KEY
repo1-s3-uri-style=path
repo1-path=/pgbackrest

; The archive is written by the primary. This machine must never expire or
; write to it, so no retention is configured here on purpose.
process-max=4
log-level-console=info
log-level-file=detail
log-path=/var/log/pgbackrest

[main]
pg1-path=/var/lib/gitclub/standby
pg1-port=5433
