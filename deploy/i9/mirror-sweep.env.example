# Install at /etc/gitclub/mirror-sweep.env, owned by the gitclub user, mode 0600.
#
# The token must be able to READ EVERY REPOSITORY. GET /api/repos returns only
# what its account can see, and the sweep mirrors exactly what it is shown, so
# a token missing access to a repository silently omits that repository from
# disaster recovery. The sweep refuses to advance the recovery target when the
# count drops, which catches a revoked grant but not one that was never made.
#
# Create it on the GitClub server as an account holding at least read on every
# namespace, then paste it here.

GITCLUB_URL=https://CHANGEME.example.com
GITCLUB_TOKEN=CHANGEME
GITCLUB_MIRRORS=/var/lib/gitclub/mirrors
